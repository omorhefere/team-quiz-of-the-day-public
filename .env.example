# Copy to `.env` for local dev. All are optional locally — the app boots with an
# empty file (uses a local PGlite DB, no analytics, no error reporting).

# Production Postgres. When unset, the app uses an in-process PGlite database.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Secret used to sign the team-session cookie. REQUIRED in production.
# SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL — used to build absolute OG image URLs in share text.
# APP_URL=https://quizleague.app

# Anthropic API key — enables AI quiz generation from sources. Get one at
# https://console.anthropic.com. Keep it secret; .env is gitignored.
# ANTHROPIC_API_KEY=sk-ant-...

# Model for quiz generation. Defaults to claude-sonnet-5-5 (good + cheaper).
# Set to claude-opus-5-5 for max quality.
# LLM_MODEL=claude-sonnet-5-5

# Model for the verifier pass that checks each question against its quote.
# LLM_VERIFY_MODEL=claude-haiku-5-5

# Sentry error reporting (server). When unset, Sentry is a no-op.
# SENTRY_DSN=

# Cloudflare Web Analytics site token (public). When unset, no beacon is injected.
# CLOUDFLARE_ANALYTICS_TOKEN=

# Local-only: persist the PGlite dev DB to disk so `npm run seed` and `npm run dev`
# share data. The npm scripts set this for you (.pgdata).
# PGLITE_DATA_DIR=.pgdata
